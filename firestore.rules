rules_version = '2';

// Regras do Firestore para o login do administrador do MontaFácil.
// A lista de e-mails autorizados fica direto AQUI, dentro da regra — para
// autorizar mais alguém, edite a lista abaixo e publique de novo.
//
// Cada implantação deste sistema usa seu próprio projeto Firebase (veja o
// README, seção "Login do administrador com Google") e sua própria lista de
// e-mails — troque os exemplos abaixo pelos e-mails reais dos administradores
// desta implantação antes de publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /adminEmails/{document=**} {
      allow read: if request.auth != null &&
        request.auth.token.email in [
          'admin@exemplo.com'
        ];
      allow write: if false;
    }
  }
}
